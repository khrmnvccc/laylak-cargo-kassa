{
  "entities": {
    "KassaDatabase": {
      "title": "KassaDatabase",
      "description": "Complete persistent database for Laylak Cargo Kassa including reports, cash ledger, expenses, accounts and logs",
      "type": "object",
      "properties": {
        "reports": {
          "type": "array",
          "description": "Daily cargo flight reports"
        },
        "kassa": {
          "type": "array",
          "description": "Sequential cash records with starting, income, expense, and balance"
        },
        "expenses": {
          "type": "array",
          "description": "Categorized expenses"
        },
        "accounts": {
          "type": "array",
          "description": "Registered user accounts (admin, kassir)"
        },
        "logs": {
          "type": "array",
          "description": "Activity audit log entries"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last modification"
        }
      },
      "required": [
        "reports",
        "kassa",
        "accounts",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/app_data/{docId}": {
      "schema": "KassaDatabase",
      "description": "Central shared cloud document synchronized in real-time across all devices"
    }
  }
}
